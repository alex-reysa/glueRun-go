{
  "schemaVersion": "v1",
  "engineVersion": "0.4.0-m1",
  "targetBranch": "agent/integration",
  "gateCommand": "bash tests/run.sh",
  "runner": "codex-run.sh",
  "areaPrefix": "engine/",
  "areas": {
    "foundation": [
      "engine/",
      "tests/",
      "cli/"
    ],
    "session": [
      "engine/",
      "tests/"
    ],
    "plancritic": [
      "engine/",
      "tests/",
      "schemas/",
      "templates/prompts/"
    ],
    "packets": [
      "engine/",
      "tests/",
      "schemas/",
      "templates/prompts/"
    ],
    "routing": [
      "engine/",
      "tests/"
    ],
    "graph": [
      "engine/",
      "tests/",
      "schemas/",
      "cli/"
    ],
    "eval": [
      "docs/",
      "README.md",
      "CHANGELOG.md"
    ]
  },
  "proofLayers": [],
  "proofGrandfather": [],
  "prewarm": "",
  "identity": {
    "l0": {
      "name": "gluerun L0",
      "email": "l0@gluerun.local"
    },
    "l1": {
      "name": "gluerun L1",
      "email": "l1@gluerun.local"
    }
  },
  "env": {
    "GLUERUN_MAX_CONCURRENT": "3",
    "GLUERUN_MAX_DISPATCH": "3",
    "GLUERUN_ENABLE_L1_PARALLEL": "1",
    "GLUERUN_CLAUDE_MODEL": "claude-opus-4-8",
    "GLUERUN_CLAUDE_L2_MODEL": "claude-opus-4-8",
    "GLUERUN_CLAUDE_L1_MODEL": "claude-opus-4-8",
    "GLUERUN_CLAUDE_PLANNER_MODEL": "claude-opus-4-8",
    "GLUERUN_CLAUDE_AUDITOR_MODEL": "claude-opus-4-8",
    "GLUERUN_CLAUDE_DECIDER_MODEL": "claude-opus-4-8",
    "GLUERUN_PLANNER_SESSION": "1",
    "GLUERUN_PLAN_CRITIQUE": "1",
    "GLUERUN_PAIRED_AUDIT_PCT": "25",
    "GLUERUN_L2_SLICE_BUDGET": "2",
    "GLUERUN_CODEX_MODEL": "gpt-5.6-sol",
    "GLUERUN_CODEX_L1_REASONING_EFFORT": "high",
    "GLUERUN_CODEX_L2_REASONING_EFFORT": "medium",
    "GLUERUN_CODEX_PLANNER_REASONING_EFFORT": "high",
    "GLUERUN_CODEX_AUDITOR_REASONING_EFFORT": "high",
    "GLUERUN_CODEX_CRITIC_REASONING_EFFORT": "high",
    "GLUERUN_CODEX_DECIDER_REASONING_EFFORT": "high",
    "GLUERUN_CODEX_READONLY_REASONING_EFFORT": "high"
  }
}
