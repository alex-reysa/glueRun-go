{
  "schemaVersion": "v1",
  "engineVersion": "0.3.0",
  "targetBranch": "agent/integration",
  "gateCommand": "bash tests/run.sh",
  "runner": "claude-run.sh",
  "areaPrefix": "engine/",
  "areas": {
    "foundation": ["engine/", "tests/", "cli/"],
    "session": ["engine/", "tests/"],
    "plancritic": ["engine/", "tests/", "schemas/", "templates/prompts/"],
    "packets": ["engine/", "tests/", "schemas/", "templates/prompts/"],
    "routing": ["engine/", "tests/"],
    "graph": ["engine/", "tests/", "schemas/", "cli/"],
    "eval": ["docs/", "README.md", "CHANGELOG.md"]
  },
  "proofLayers": [],
  "proofGrandfather": [],
  "prewarm": "",
  "identity": {
    "l0": { "name": "gluerun L0", "email": "l0@gluerun.local" },
    "l1": { "name": "gluerun L1", "email": "l1@gluerun.local" }
  },
  "env": {
    "GLUERUN_MAX_CONCURRENT": "3",
    "GLUERUN_MAX_DISPATCH": "3",
    "GLUERUN_ENABLE_L1_PARALLEL": "1",
    "GLUERUN_CLAUDE_MODEL": "claude-opus-4-8",
    "GLUERUN_CLAUDE_L2_MODEL": "claude-opus-4-8",
    "GLUERUN_CLAUDE_L1_MODEL": "claude-opus-4-8",
    "GLUERUN_CLAUDE_PLANNER_MODEL": "claude-opus-4-8",
    "GLUERUN_CLAUDE_AUDITOR_MODEL": "claude-opus-4-8",
    "GLUERUN_CLAUDE_DECIDER_MODEL": "claude-opus-4-8"
  }
}
