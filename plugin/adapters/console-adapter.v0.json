    ],
    "nextAreas": [
      "singular",
      "next-areas"
    ]
  },
  "processMatchers": {
    "includeSubstrings": [
      "scripts/orchestration",
      "autonomate",
      "l1-drive",
      "/.worktrees/"
    ],
    "includeAllOf": [
      [
        "codex",
        "singular",
        "exec"
      ]
    ],
    "excludeSubstrings": [
      "singular_graph_server.py",
      " rg "
    ],
    "excludeSubstringsLowered": [
      "cursor helper"
    ]
  },
  "logFileMaps": {
    "codexLogs": [
      [
        "worker-codex.log",
        "worker"
      ],
      [
        "auditor-codex.log",
        "auditor"
      ],
      [
        "planner-codex.log",
        "planner"
      ],
      [
        "decider-codex.log",
        "decider"
      ],
      [
        "assistant-codex.log",
        "assistant"
      ],
      [
        "supervisor-codex.log",
        "supervisor"
      ]
    ],
    "plainLogs": [
      "gate-check.log",
      "scope-check.log",
      "secret-scan.log"
    ]
  },
  "settingsSource": "{engineHome}/engine"
}
