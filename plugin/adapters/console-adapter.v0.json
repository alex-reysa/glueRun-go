  "idPatterns": {
    "task": "^TASK-\\d+$",
    "node": "^[A-Z][0-9]+\\.[A-Za-z0-9_]+$",
    "area": "^[a-z][a-z0-9_]*$"
  },
  "plannerPromptPatterns": {
    "area": "Area Planner for area `([^`]+)`",
    "node": "Executable DAG node:\\s*`([^`]+)`",
    "stage": "(?m)^Stage:\\s*`([^`]+)`",
    "layer": "(?m)^Layer:\\s*`([^`]+)`"
  },
  "settingsSpec": [
    {
      "title": "Models & reasoning \u00b7 role matrix",
      "layout": "matrix",
      "items": [
        {
          "envKey": "SINGULAR_CODEX_MODEL",
          "label": "model",
          "default": "gpt-5.5",
          "kind": "model",
          "unit": "",
          "meaning": "Codex model all three roles run on"
        },
        {
          "envKey": "SINGULAR_CODEX_SERVICE_TIER",
          "label": "service tier",
          "default": "default",
          "kind": "enum",
          "unit": "",
          "meaning": "API service tier (default = standard queue)"
        },
        {
          "envKey": "SINGULAR_CODEX_PLANNER_REASONING_EFFORT",
          "label": "planner reasoning",
          "default": "xhigh",
          "kind": "reasoning",
          "unit": "",
          "meaning": "effort the L1 area planner spends \u2014 plan quality gates everything downstream"
        },
        {
          "envKey": "SINGULAR_CODEX_L2_REASONING_EFFORT",
          "label": "worker reasoning",
          "default": "medium",
          "kind": "reasoning",
          "unit": "",
          "meaning": "effort each L2 developer worker spends on a task slice"
        },
        {
          "envKey": "SINGULAR_CODEX_AUDITOR_REASONING_EFFORT",
          "label": "auditor reasoning",
          "default": "high",
          "kind": "reasoning",
          "unit": "",
          "meaning": "effort the diff auditor spends reviewing a packet before the gate"
        }
      ]
    },
    {
      "title": "Throughput \u00b7 work flowing per cycle",
      "layout": "list",
      "items": [
        {
          "envKey": "SINGULAR_MAX_CONCURRENT",
          "label": "max concurrent workers",
          "default": "1",
          "kind": "count",
          "unit": "",
          "meaning": "L2 workers running at the same time"
        },
        {
          "envKey": "SINGULAR_MAX_DISPATCH",
          "label": "max dispatch / cycle",
          "default": "follows max concurrent",
          "kind": "derived",
          "unit": "",
          "meaning": "tasks dispatched per cycle; unset, so it follows max concurrent workers"
        },
        {
          "envKey": "SINGULAR_MAX_L1_CONCURRENT",
          "label": "max parallel L1 planners",
          "default": "3",
          "kind": "count",
          "unit": "",
          "meaning": "area planners that may plan at once \u2014 only when parallel planning is on (below)"
        },
        {
          "envKey": "SINGULAR_ENABLE_L1_PARALLEL",
          "label": "L1 parallel planning",
          "default": "0",
          "kind": "bool",
          "unit": "",
          "meaning": "off = plan one area at a time; gates the parallel-planner limit above"
        },
        {
          "envKey": "SINGULAR_L1_TASKS_PER_NODE",
          "label": "tasks per planner node",
          "default": "1",
          "kind": "count",
          "unit": "",
          "meaning": "tasks an L1 planner emits per DAG node"
        },
        {
          "envKey": "SINGULAR_L2_SLICE_BUDGET",
          "label": "L2 slice budget",
          "default": "1",
          "kind": "count",
          "unit": "",
          "meaning": "starting work-slices granted to a worker per task"
        },
        {
          "envKey": "SINGULAR_L2_SLICE_BUDGET_MAX",
          "label": "L2 slice budget cap",
          "default": "3",
          "kind": "count",
          "unit": "",
          "meaning": "hard ceiling the slice budget can grow to"
        }
      ]
    },
    {
      "title": "Safety limits",
      "layout": "list",
      "items": [
        {
          "envKey": "SINGULAR_MAX_RETRIES",
          "label": "max task retries",
          "default": "3",
          "kind": "count",
          "unit": "",
          "meaning": "attempts on a failing task before it is parked as a blocked escalation"
        },
        {
          "envKey": "SINGULAR_MAX_CONSEC_FAILS",
          "label": "circuit-breaker threshold",
          "default": "5",
          "kind": "count",
          "unit": "",
          "meaning": "consecutive failures that trip the breaker and halt the loop"
        },
        {
          "envKey": "SINGULAR_MAX_HOURS",
          "label": "loop budget",
          "default": "20",
          "kind": "duration",
          "unit": "h",
          "meaning": "wall-clock hours before the loop voluntarily exits"
        },
        {
          "envKey": "SINGULAR_MIN_DISK_GB",
          "label": "min free disk",
          "default": "2",
          "kind": "bytes",
          "unit": "GB",
          "meaning": "loop refuses to start a cycle below this free-space floor"
        },
        {
          "envKey": "SINGULAR_L1_STALE_MINUTES",
          "label": "L1 stale timeout",
          "default": "60",
          "kind": "duration",
          "unit": "min",
          "meaning": "an L1 planner lease idle this long is reclaimed as stale"
        },
        {
          "envKey": "SINGULAR_PLANNER_BACKOFF_SECONDS",
          "label": "planner backoff",
          "default": "900",
          "kind": "duration",
          "unit": "s",
          "meaning": "wait after a planner error before re-planning"
        },
        {
          "envKey": "SINGULAR_PLANNER_QUOTA_BACKOFF_SECONDS",
          "label": "planner quota backoff",
          "default": "1800",
          "kind": "duration",
          "unit": "s",
          "meaning": "longer wait after a planner quota / rate-limit rejection"
        },
        {
          "envKey": "SINGULAR_PLANNER_OVERLOAD_BACKOFF_SECONDS",
          "label": "planner overload backoff",
          "default": "180",
          "kind": "duration",
          "unit": "s",
          "meaning": "short wait after a provider 503/529; transient capacity, not a usage limit"
        },
        {
          "envKey": "SINGULAR_OVERLOAD_WAIT_BUDGET",
          "label": "overload wait budget",
          "default": "3600",
          "kind": "duration",
          "unit": "s",
          "meaning": "total overload sleep-through before the loop writes STOP (separate from the quota budget)"
        }
      ]
    },
    {
      "title": "Loop behavior",
      "layout": "list",
      "items": [
        {
          "envKey": "SINGULAR_AUTO_INTEGRATE",
          "label": "auto-integrate",
          "default": "1",
          "kind": "bool",
          "unit": "",
          "meaning": "on = merge passing worker branches into the target automatically"
        },
        {
          "envKey": "SINGULAR_PUSH",
          "label": "push to remote",
          "default": "1",
          "kind": "bool",
          "unit": "",
          "meaning": "on = push the target branch to origin after integrating"
        },
        {
          "envKey": "SINGULAR_GENERATE",
          "label": "task generation",
          "default": "1",
          "kind": "bool",
          "unit": "",
          "meaning": "on = let planners generate new tasks; off = drain the existing queue only"
        },
        {
          "envKey": "SINGULAR_SLEEP",
          "label": "cycle sleep",
          "default": "20",
          "kind": "duration",
          "unit": "s",
          "meaning": "pause between loop cycles"
        },
        {
          "envKey": "SINGULAR_TARGET_BRANCH",
          "label": "target branch",
          "default": "codex/singular-bootstrap-target",
          "kind": "identifier",
          "unit": "",
          "meaning": "branch the loop integrates and pushes to"
        }
      ]
    }
  ],
  "paths": {
    "dagFile": "docs/orchestration/dag.v0.json",
    "stageDoc": "docs/plan-and-dag.md",
    "gatesDir": "docs/orchestration/gates",
    "tasksDir": "docs/orchestration/tasks",
    "areasDir": "docs/orchestration/areas",
    "stateDir": ".singular-state",
    "eventsLog": "events.ndjson",
    "autonomateLog": "autonomate.out.log",
    "statusFile": ".singular-state/STATUS.md",
    "circuitFile": ".singular-state/circuit.json",
    "stopFile": ".singular-state/STOP",
    "orchScriptsDir": "scripts/orchestration",
    "platformVision": "docs/core/platform-vision.md"
