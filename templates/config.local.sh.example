# Operator-local overrides + secrets (gitignored). Copy to
# .gluerun-state/config.local.sh in your repo. Highest precedence — wins over
# gluerun.config.json and gluerun.config.sh. Never commit secrets.
#
# Example:
# export ANTHROPIC_API_KEY="sk-..."
# export GLUERUN_CLAUDE_L2_MODEL="claude-sonnet-4-6"
# export GLUERUN_CLAUDE_PLANNER_MODEL="claude-opus-4-8"
# export GLUERUN_MAX_CONCURRENT=2
# export GLUERUN_PUSH=0
