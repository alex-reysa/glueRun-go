{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gluerun.orchestration.task-batch.v0",
  "title": "gluerun Task Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tasks"],
  "properties": {
    "schema": { "const": "gluerun.orchestration.task-batch.v0" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "markdown"],
        "properties": {
          "taskId": { "type": "string", "pattern": "^TASK-[0-9]{4,}$" },
          "markdown": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
