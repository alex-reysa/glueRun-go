{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gluerun.orchestration.dag.v0",
  "title": "gluerun Planning DAG",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "nodes"],
  "properties": {
    "schema": { "const": "gluerun.orchestration.dag.v0" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stage",
          "area",
          "layer",
          "kind",
          "dependsOn",
          "requiredCompletion"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "minLength": 1 },
          "area": { "type": "string", "minLength": 1 },
          "layer": {
            "type": "string",
            "enum": [
              "contract",
              "storage_substrate_base",
              "storage_spec",
              "storage_proof",
              "service",
              "binding_runtime",
              "dispatch_runtime",
              "decision_gate_runtime",
              "recovery_runtime",
              "scheduler_runtime",
              "projection_storage",
              "product_api_runtime",
              "extension_contracts"
            ]
          },
          "kind": {
            "type": "string",
            "enum": ["contract", "substrate", "storage", "runtime", "product_api", "extension"]
          },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "requiredCompletion": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    }
  }
}
