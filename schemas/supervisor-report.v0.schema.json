{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gluerun.orchestration.supervisor-report.v0",
  "title": "gluerun Supervisor Briefing Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "stage", "narrative"],
  "properties": {
    "schema": { "const": "gluerun.orchestration.supervisor-report.v0" },
    "stage": { "type": "string", "minLength": 1 },
    "narrative": { "type": "string", "minLength": 1 },
    "risks": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "nextSteps": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "proposedSettings": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "generatedAt": { "type": "string" },
    "runId": { "type": "string" }
  }
}
